# Configurações para Deploy via SFTP (deploy_web.sh e deploy_web.ps1)
# Copie este arquivo para .env e preencha com as credenciais do seu servidor.

SFTP_HOST=seu-servidor.com
SFTP_PORT=22
SFTP_USER=usuario
SFTP_REMOTE_DIR=/caminho/no/servidor
# SFTP_KEY=/caminho/para/chave_id_rsa (Opcional - caminho para a chave SSH privada)
# SFTP_PASS=sua_senha (Opcional - requer sshpass no linux para deploy_web.sh)

# Google Drive Backup & Sync (OAuth 2.0 Client ID)
# Crie no Google Cloud Console um Client ID do tipo "Aplicativo da Web".
# Em "Origens JavaScript autorizadas", adicione exatamente (sem barra no final):
#   http://localhost:5000
#   http://localhost
#   https://seapruma.wladapps.com (sua URL de produção)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

